package pages

// LoginPage renders an error page shown when GitHub OAuth is not configured.
templ LoginPage(flashErr string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Sign in — morsel admin</title>
			@inlineCSS()
		</head>
		<body>
			<div class="login-shell">
				<div class="login-card">
					<div class="login-logo">morsel</div>
					<div class="login-sub">Platform admin console</div>
					if flashErr != "" {
						<div class="alert alert--warn" style="margin-bottom:20px">{ flashErr }</div>
					}
				</div>
			</div>
		</body>
	</html>
}
