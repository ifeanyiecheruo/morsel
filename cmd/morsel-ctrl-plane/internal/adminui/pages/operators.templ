package pages

// OperatorsPage renders the Operators management view.
templ OperatorsPage(d OperatorsPageData) {
	@Layout("operators", "Operators") {
		<h1 class="page-title">Operators</h1>
		<p class="page-sub">Manage principals with admin UI access.</p>
		<hr/>
		if d.Flash != "" {
			<div class="alert alert--warn" style="margin-bottom:16px">{ d.Flash }</div>
		}
		if len(d.Rows) == 0 {
			<div class="empty">No operators configured.</div>
		} else {
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th>GitHub login</th>
							<th>Role</th>
						</tr>
					</thead>
					<tbody>
						for _, row := range d.Rows {
							<tr>
								<td>{ row.GithubLogin }</td>
								<td>
									if row.IsAdmin {
										<span class="badge badge--blue">Admin</span>
									} else {
										<span class="badge">Operator</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}
